---
// Aperçu de 6 photos sur l'accueil — la galerie complète (63 photos) vit sur
// sa propre page dédiée, /galerie (voir src/pages/galerie.astro).
const photos = [
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167100/WhatsApp_Image_2026-08-19_at_20.04.37_ptf2cj.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167099/WhatsApp_Image_2026-08-19_at_20.04.37_1_rb5pu9.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167098/WhatsApp_Image_2026-08-19_at_20.04.18_bhuxvk.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167098/WhatsApp_Image_2026-08-19_at_20.04.17_wi1hfy.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167098/WhatsApp_Image_2026-08-19_at_20.04.33_1_zlaaxx.jpg",
  "https://res.cloudinary.com/di21pnpda/image/upload/v1787167095/WhatsApp_Image_2026-08-19_at_20.04.25_uun3iz.jpg",
];

function thumb(url) {
  return url.replace("/upload/", "/upload/w_500,h_500,c_fill,g_auto,f_auto,q_auto/");
}
---

<section class="py-16 sm:py-24 bg-gradient-to-b from-white to-slate-50 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <!-- Section Header -->
    <div class="mb-16 space-y-4 text-center animate-fade-up">
      <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">
        Galerie
      </p>
      <h2 class="text-4xl md:text-5xl font-heading font-bold text-slate-900">
        Les moments marquants des éditions précédentes
      </h2>
      <p class="mx-auto max-w-2xl text-lg text-slate-600">
        Découvrez les plus beaux moments du concours Miss Gbévivi Bénin
      </p>
    </div>

    <!-- Photo Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {photos.map((src, index) => (
        <a
          href={src}
          target="_blank"
          rel="noopener noreferrer"
          class="group relative block rounded-2xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-300 hover:scale-105"
          aria-label="Voir la photo en pleine résolution"
        >
          <img
            src={thumb(src)}
            alt={`Miss Gbévivi Bénin — photo ${index + 1}`}
            loading="lazy"
            class="w-full h-64 object-cover group-hover:brightness-75 transition-all duration-300"
          />
          <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-300 flex items-center justify-center">
            <svg class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Button -->
    <div class="text-center">
      <a
        href="/galerie"
        class="inline-flex items-center gap-2 px-8 py-4 bg-gradient-primary text-white font-semibold rounded-lg hover:shadow-lg hover:scale-105 transition-all duration-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-500"
      >
        <span>📸 Voir toutes les photos</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>
  </div>
</section>
