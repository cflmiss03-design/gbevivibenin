---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroHeader from "../components/HeroHeader.astro";
import Actu from "../components/Actu.astro";
import Description from "../components/Description.astro"; 
import Progress from "../components/Progress.jsx";
import CandidateGrid from "../components/CandidateGrid.jsx";
import GallerySection from "../components/GallerySection.astro";
import TicketPurchase from "../components/TicketPurchase.jsx";
import { candidates } from "../data/candidates.js";
import { SEO_VOTING_START_DATE, SEO_VOTING_END_DATE } from "../config";

const title = "Miss Gbévivi Bénin 2026";
const description = "Miss Gbévivi Bénin 2026 : découvrez les candidates, votez en ligne et soutenez la culture béninoise. Votes sécurisés via FedaPay.";
const keywords = "Miss Gbévivi Bénin, Miss Gbévivi Bénin 2026, concours beauté Bénin, candidates Miss, culture béninoise, jeunesse béninoise";

// Pas de logo/photo officiel(le), de coordonnées ni de prix de vote
// confirmés pour l'instant — champs volontairement omis plutôt qu'inventés
// (voir aussi BaseLayout.astro, Header.astro, Footer.astro).
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://missgbevivibenin.site/#organization",
      "name": "Miss Gbévivi Bénin",
      "description": "Concours culturel béninois promouvant le patrimoine culturel et la jeunesse",
      "url": "https://missgbevivibenin.site",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BJ"
      }
    },
    {
      "@type": "Event",
      "@id": "https://missgbevivibenin.site/#event-miss",
      "name": "Miss Gbévivi Bénin 2026",
      "description": "Concours officiel Miss Gbévivi Bénin célébrant la beauté, le talent et le patrimoine culturel béninois",
      "startDate": SEO_VOTING_START_DATE,
      "endDate": SEO_VOTING_END_DATE,
      "eventStatus": "EventScheduled",
      "eventAttendanceMode": "OnlineEventAttendanceMode",
      "location": {
        "@type": "VirtualLocation",
        "url": "https://missgbevivibenin.site"
      },
      "organizer": {
        "@id": "https://missgbevivibenin.site/#organization"
      },
      "url": "https://missgbevivibenin.site"
    }
  ]
};
---

<BaseLayout 
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  structuredData={structuredData}
>
  <main class="min-h-screen bg-white">
    <HeroHeader />
    <section class="py-8"><Actu /></section>
    <section class="py-8"><Description /></section>

    <section id="tickets" class="relative overflow-hidden py-16 sm:py-24">
      {/* Orbes décoratives en dégradé */}
      <div class="pointer-events-none absolute inset-0 overflow-hidden">
        <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-primary-400/30 blur-3xl animate-float"></div>
        <div class="absolute top-1/3 -right-32 h-[28rem] w-[28rem] rounded-full bg-secondary-400/20 blur-3xl animate-float" style="animation-delay: 1.5s"></div>
      </div>

      <div class="relative mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center space-y-3 sm:space-y-4 mb-8 sm:mb-12">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] sm:tracking-[0.3em] text-primary-600">Tickets officiels</p>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-heading font-black text-slate-900">
          Achetez votre ticket
        </h2>
        <p class="text-base sm:text-lg text-slate-600 max-w-2xl mx-auto px-2">
          Réservez votre place pour le concours Miss Gbévivi Bénin.
        </p>
      </div>

      <div class="relative mx-auto max-w-5xl px-3 sm:px-6 lg:px-8">
        <div class="glass rounded-2xl sm:rounded-3xl shadow-premium border border-white/40 p-4 sm:p-10 animate-fade-up">
          <TicketPurchase client:load />
        </div>
      </div>
    </section>

    <section id="candidates" class="px-4 sm:px-6 lg:px-8 py-16 sm:py-24">
      <div class="mx-auto max-w-7xl">
        <Progress client:load />
        <CandidateGrid candidates={candidates} client:load />
      </div>
    </section>
    <GallerySection />
  </main> 
</BaseLayout>
