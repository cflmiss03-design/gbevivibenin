---
import BaseLayout from "../layouts/BaseLayout.astro";
import RegisterForm from "../components/RegisterForm.jsx";

const title = "Inscription Candidate – Concours Miss Gbévivi Bénin 2026";
const description = "Inscrivez-vous au Concours Miss Gbévivi Bénin 2026 et participez à l'aventure extraordinaire du Festival Culturel des Jeunes Béninois. Candidatures ouvertes jusqu'à fin mai 2026.";
const keywords = "inscription Miss Gbévivi Bénin, candidature concours beauté, s'inscrire Miss Gbévivi Bénin, Miss Bénin 2026";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://missgbevivibenin.site/register/#webpage",
      "name": "Inscription Candidate",
      "url": "https://missgbevivibenin.site/register",
      "isPartOf": {
        "@id": "https://missgbevivibenin.site/#website"
      }
    },
    {
      "@type": "Event",
      "@id": "https://missgbevivibenin.site/register/#event",
      "name": "Miss Gbévivi Bénin 2026 - Candidature",
      "description": "Période d'inscriptions pour le concours Miss Gbévivi Bénin 2026",
      "startDate": "2026-01-01",
      "endDate": "2026-05-31",
      "eventStatus": "EventScheduled",
      "url": "https://missgbevivibenin.site/register",
      "organizer": {
        "@type": "Organization",
        "name": "Miss Gbévivi Bénin",
        "url": "https://missgbevivibenin.site"
      }
    }
  ]
};
---

<BaseLayout 
  title={title} 
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  structuredData={structuredData}
  robots="noindex,nofollow"
>
  <main class="min-h-screen bg-gradient-to-b from-white to-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl animate-fade-up">
      
      {/* Header */}
      <div class="text-center mb-12 space-y-4">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Rejoignez-nous</p>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900">
          Inscription Candidate
        </h1>
        <p class="text-lg text-slate-600 max-w-xl mx-auto">
          Inscrivez-vous au Concours Miss Gbévivi Bénin 2026 et participez à cette aventure extraordinaire.
        </p>
      </div>

      {/* Form Card */}
      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-8 sm:p-10 animate-fade-up" style="animation-delay: 0.1s">
        <RegisterForm client:load />
      </div>

      {/* Info Box */}
      <div class="mt-8 p-6 rounded-xl bg-primary-50 border border-primary-200 text-center animate-fade-up" style="animation-delay: 0.2s">
        <p class="text-sm text-slate-600">
          <strong class="text-slate-900">Avez-vous des questions ?</strong><br />
          Contactez-nous sur <a href="https://wa.me/22991915070" class="text-primary-600 hover:text-primary-700 font-semibold">WhatsApp</a>
        </p>
      </div>

    </div>
  </main>
</BaseLayout>
