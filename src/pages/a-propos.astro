---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "À Propos de Miss Gbévivi Bénin – Mission & Patrimoine Culturel";
const description = "Créé en 2018, Miss Gbévivi Bénin est un concours culturel dédié à la valorisation et à la transmission du patrimoine culturel béninois : langues locales, panégyriques, art culinaire, traditions et savoirs.";
const keywords = "Gbévivi, patrimoine culturel Bénin, mission culturelle, Miss Gbévivi Bénin, jeunesse béninoise, culture béninoise, identité culturelle, langue fon";

// Pas de logo/photo officiel(le), de coordonnées ni de réseaux sociaux
// confirmés pour l'instant — champs volontairement omis plutôt qu'inventés
// (voir aussi BaseLayout.astro, Header.astro, Footer.astro).
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": "https://missgbevivibenin.site/a-propos/#aboutpage",
      "name": "À Propos - Miss Gbévivi Bénin",
      "url": "https://missgbevivibenin.site/a-propos",
      "isPartOf": {
        "@id": "https://missgbevivibenin.site/#website"
      }
    },
    {
      "@type": "Organization",
      "@id": "https://missgbevivibenin.site/a-propos/#organization",
      "name": "Miss Gbévivi Bénin",
      "description": "Concours culturel béninois, créé en 2018, dédié à la valorisation et à la transmission du patrimoine culturel béninois",
      "foundingDate": "2018",
      "url": "https://missgbevivibenin.site",
      "address": {
        "@type": "PostalAddress",
        "addressCountry": "BJ"
      }
    }
  ]
};

const PILIERS = [
  { icon: "🗣️", title: "Les Langues", text: "Les langues locales sont des patrimoines vivants. Elles portent l'histoire, les valeurs, les expressions et la mémoire des communautés. À travers Miss Gbévivi, les candidates sont invitées à connaître et à valoriser les langues de leurs communautés et à contribuer à leur transmission." },
  { icon: "🪶", title: "Les Panégyriques", text: "Les panégyriques constituent une richesse culturelle qui permet de raconter les origines, l'histoire et l'identité des communautés. Ils représentent un moyen de maintenir vivante une mémoire transmise à travers les générations." },
  { icon: "🍲", title: "L'Art Culinaire", text: "La cuisine est l'une des expressions les plus vivantes de la culture. Les plats, les ingrédients, les techniques de préparation et les habitudes culinaires racontent l'histoire et l'identité des différentes communautés du Bénin." },
  { icon: "💃", title: "Les Traditions", text: "Danses, cérémonies, pratiques et expressions artistiques constituent autant de témoignages de la richesse culturelle béninoise, un patrimoine vivant qui mérite d'être préservé." },
  { icon: "📚", title: "Les Savoirs", text: "Chaque communauté possède des connaissances et des savoir-faire qui constituent une véritable richesse. Miss Gbévivi souhaite favoriser leur découverte et leur transmission aux générations futures." },
];

const OBJECTIFS = [
  "La connaissance des langues locales",
  "La découverte et la valorisation des panégyriques",
  "La connaissance de l'art culinaire béninois",
  "La découverte des traditions et des savoirs locaux",
  "La fierté de son identité culturelle",
  "La transmission des connaissances aux générations futures",
];
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  structuredData={structuredData}
>
  <main class="min-h-screen bg-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl animate-fade-up">
      <div class="mb-12 space-y-4 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Notre Identité</p>
        <h1 class="text-4xl md:text-5xl font-heading font-bold text-slate-900">
          Miss Gbévivi Bénin
        </h1>
        <p class="text-lg text-slate-600 max-w-2xl mx-auto">
          Une initiative dédiée à la valorisation de la culture béninoise
        </p>
      </div>

      <!-- À Propos -->
      <div class="mb-20">
        <div class="grid lg:grid-cols-2 gap-10 items-center">

          <div class="w-full h-[350px] lg:h-[450px] rounded-3xl shadow-xl overflow-hidden">
            <img
              src="https://res.cloudinary.com/di21pnpda/image/upload/w_800,h_1000,c_fill,g_auto,f_auto,q_auto/v1787167099/WhatsApp_Image_2026-08-19_at_20.04.37_1_rb5pu9.jpg"
              alt="Miss Gbévivi Bénin"
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>

          <div>
            <h2 class="text-3xl font-bold text-primary-600 mb-6">
              À Propos de Miss Gbévivi Bénin
            </h2>

            <p class="text-gray-700 text-lg leading-relaxed mb-6">
              Créé en <strong>2018</strong>, <strong>Miss Gbévivi Bénin</strong> est un concours culturel qui œuvre à la valorisation et à la transmission du patrimoine culturel béninois auprès des jeunes filles et des femmes.
            </p>

            <p class="text-gray-700 text-lg leading-relaxed">
              À travers ce concours, l'initiative encourage les participantes à mieux connaître leurs origines, leurs traditions et les richesses culturelles de leurs communautés — notamment les langues locales, les panégyriques ainsi que les habitudes et spécialités culinaires propres aux différentes localités du Bénin.
            </p>

            <div class="mt-8 grid grid-cols-2 gap-4">
              <div class="rounded-xl bg-primary-50 border border-primary-200 p-4">
                <p class="text-2xl font-bold text-primary-600">2018</p>
                <p class="text-sm text-slate-600">Année de création</p>
              </div>

              <div class="rounded-xl bg-secondary-50 border border-secondary-200 p-4">
                <p class="text-2xl font-bold text-secondary-600">8ᵉ</p>
                <p class="text-sm text-slate-600">Édition 2026</p>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Que signifie Gbévivi -->
      <div class="mb-16 rounded-2xl bg-gradient-to-br from-primary-50 to-secondary-50 border border-primary-200 p-8">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Que signifie « Gbévivi » ?</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-4">
          <strong>Gbévivi</strong> est un terme en langue fon qui signifie :
        </p>
        <p class="text-2xl font-bold text-primary-700 italic mb-4">
          « Le monde est agréable et intéressant. »
        </p>
        <p class="text-gray-700 text-lg leading-relaxed">
          Cette signification traduit la philosophie portée par le projet. La connaissance de sa culture, de sa langue, de son histoire et de sa gastronomie peut être une source de fierté, d'épanouissement et de bien-être. À travers Miss Gbévivi Bénin, les participantes sont invitées à découvrir leur patrimoine, à mieux le comprendre et à contribuer à sa transmission.
        </p>
      </div>

      <!-- Notre Vision -->
      <div class="mb-12 space-y-8">
        <div>
          <h2 class="text-3xl font-bold text-slate-900 mb-4">Notre Vision</h2>
          <p class="text-gray-700 text-lg leading-relaxed">
            Faire de la culture une source de fierté et de transmission. Miss Gbévivi Bénin aspire à contribuer à une génération de jeunes filles et de femmes davantage conscientes de la richesse de leur identité culturelle. Le projet souhaite créer un espace où la beauté et l'élégance peuvent s'exprimer tout en étant profondément liées à la connaissance et à la valorisation du patrimoine.
          </p>
        </div>
      </div>

      <!-- Notre Mission -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Notre Mission</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-8">
          Promouvoir la connaissance, la valorisation et la transmission des richesses culturelles béninoises à travers un concours qui place les jeunes filles et les femmes au cœur de cette démarche. Nous voulons notamment encourager :
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {OBJECTIFS.map((obj) => (
            <div class="rounded-xl bg-primary-50 border border-primary-200 p-6">
              <div class="flex items-start gap-3">
                <span class="text-2xl flex-shrink-0 mt-1 text-primary-600">✓</span>
                <p class="text-slate-700">{obj}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- La Culture au Cœur du Concours -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">La Culture au Cœur du Concours</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-8">
          Miss Gbévivi Bénin considère la culture comme un patrimoine vivant. Elle ne se limite pas aux monuments, aux objets ou aux événements historiques : elle vit aussi dans les langues que nous parlons, les histoires que nous racontons, les noms que nous portons, les plats que nous préparons et les savoirs que nous transmettons.
        </p>
        <div class="space-y-6">
          {PILIERS.map((p) => (
            <div class="rounded-2xl border border-slate-200 p-8">
              <h3 class="text-xl font-bold text-slate-900 mb-3">{p.icon} {p.title}</h3>
              <p class="text-gray-700 leading-relaxed">{p.text}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Au-delà du Concours -->
      <div class="mb-16">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Au-delà du Concours</h2>
        <p class="text-gray-700 text-lg leading-relaxed mb-8">
          Miss Gbévivi Bénin ne se limite pas à l'organisation d'une compétition. Au fil de son évolution, le projet a développé des initiatives communautaires qui prolongent les valeurs qu'il porte.
        </p>
        <div class="space-y-6">
          <div class="rounded-2xl border border-slate-200 p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-3">👥 Club Gbévivi</h3>
            <p class="text-gray-700 leading-relaxed">
              Le Club Gbévivi rassemble autour du projet des personnes qui partagent sa vision et ses valeurs — un espace de rencontre, de partage et de participation à la dynamique portée par Gbévivi. Les informations détaillées sur son fonctionnement seront complétées à partir des données officielles de l'organisation.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-3">🤲 Tontine Gbévivi</h3>
            <p class="text-gray-700 leading-relaxed">
              La Tontine Gbévivi s'inscrit dans la dynamique communautaire développée autour du projet, traduisant la volonté de renforcer les liens, la solidarité et l'entraide entre les membres de la communauté. Ses modalités et objectifs détaillés seront précisés à partir des informations officielles de l'organisation.
            </p>
          </div>
          <div class="rounded-2xl border border-slate-200 p-8">
            <h3 class="text-xl font-bold text-slate-900 mb-3">❤️ Noël en Famille</h3>
            <p class="text-gray-700 leading-relaxed">
              L'engagement de Gbévivi se traduit aussi par des actions en faveur d'enfants vulnérables, notamment l'initiative « Noël en famille », organisée avec des enfants orphelins — un moment de joie et de convivialité, dans un esprit de proximité et de solidarité. Au-delà du concours, cette action rappelle que l'engagement communautaire fait partie intégrante des valeurs portées par Gbévivi.
            </p>
          </div>
        </div>
      </div>

      <!-- Une Histoire qui se Poursuit -->
      <div class="mb-16 space-y-8">
        <div class="rounded-2xl bg-gradient-to-br from-primary-50 to-secondary-50 border border-primary-200 p-8">
          <p class="text-sm font-semibold uppercase tracking-widest text-primary-600 mb-2">2018 → 2026</p>
          <h2 class="text-3xl font-bold text-slate-900 mb-6">Une Histoire qui se Poursuit</h2>
          <p class="text-lg leading-relaxed text-gray-700 mb-4">
            Depuis sa création en 2018, Miss Gbévivi Bénin poursuit son engagement en faveur de la culture, de la transmission et de la valorisation des identités culturelles béninoises. L'édition 2026, qui marque la <strong>8ᵉ édition</strong>, s'inscrit dans cette continuité.
          </p>
          <p class="text-lg leading-relaxed text-gray-700 italic">
            Parce qu'une reine peut porter bien plus qu'une couronne : elle peut porter une culture.
          </p>
        </div>
      </div>

      <!-- Devenez Partenaire -->
      <div class="mb-12 rounded-2xl bg-gradient-to-br from-secondary-600 to-secondary-800 text-white p-8">
        <h2 class="text-3xl font-bold mb-4">Devenez Partenaire de l'Aventure</h2>
        <p class="text-lg mb-6 text-white/90">
          Miss Gbévivi Bénin rassemble autour de la culture, de la jeunesse, de la femme et de l'engagement communautaire. Entreprises, institutions, médias et organisations peuvent contribuer à cette aventure en devenant partenaires de l'édition 2026.
        </p>
        <a href="/sponsoring" class="inline-block bg-white text-secondary-600 font-semibold px-8 py-3 rounded-lg hover:bg-secondary-50 transition-colors duration-200">
          En savoir plus sur les partenariats
        </a>
      </div>

      <!-- Contactez-nous -->
      <div class="rounded-2xl bg-slate-50 border border-slate-200 p-8">
        <h2 class="text-3xl font-bold text-slate-900 mb-4">Contactez-nous</h2>
        <div class="space-y-4 text-gray-700">
          <p class="text-lg">
            Vous avez des questions ou souhaitez collaborer avec Miss Gbévivi Bénin ? N'hésitez pas à nous contacter.
          </p>
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.67-.51-.173-.008-.371 0-.57 0-.198 0-.52.075-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.076 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421-7.403h-.004a9.87 9.87 0 00-5.031 1.378c-3.055 2.007-5.044 5.645-5.044 9.589 0 3.601 1.926 6.853 5.305 8.796 1.906 1.24 4.109 1.856 6.396 1.991.503.034 1.007.053 1.509.049 5.264-.15 9.776-3.764 11.218-8.885.793-2.855.922-5.985.385-8.995-.671-3.73-3.007-6.85-6.182-8.796-1.906-1.24-4.109-1.856-6.396-1.991-.503-.034-1.007-.053-1.509-.049zm3.1 10.033a4.26 4.26 0 01-.968-5.307 4.26 4.26 0 015.307.968 4.26 4.26 0 01-.968 5.307 4.26 4.26 0 01-5.307-.968z"/>
            </svg>
            <span class="text-lg">WhatsApp : <span class="text-slate-500 italic">à confirmer</span></span>
          </div>
          <div class="flex items-center gap-3">
            <svg class="w-6 h-6 text-primary-600 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
            </svg>
            <span class="text-lg">Email : <span class="text-slate-500 italic">à confirmer</span></span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="w-6 h-6 text-primary-600 flex-shrink-0 mt-1" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
            </svg>
            <span class="text-lg">Adresse : République du Bénin</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
