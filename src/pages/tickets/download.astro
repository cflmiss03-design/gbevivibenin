---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TicketDownload from "../../components/TicketDownload.jsx";
---

<BaseLayout
  title="Télécharger mes tickets – Miss Gbévivi Bénin"
  description="Téléchargez vos tickets Miss Gbévivi Bénin."
  robots="noindex,nofollow"
>
  <main class="min-h-screen bg-slate-50 py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <div class="mb-8 space-y-2 text-center">
        <p class="text-sm font-semibold uppercase tracking-widest text-primary-600">Tickets</p>
        <h1 class="text-3xl md:text-4xl font-heading font-bold text-slate-900">
          Mes tickets
        </h1>
      </div>

      <div class="bg-white rounded-2xl shadow-lg border border-slate-200 p-6 sm:p-10">
        <TicketDownload client:load />
      </div>
    </div>
  </main>
</BaseLayout>
