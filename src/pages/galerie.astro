---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "Galerie – Miss Gbévivi Bénin";
const description = "Découvrez en images les moments marquants du concours Miss Gbévivi Bénin.";
const keywords = "galerie Miss Gbévivi Bénin, photos concours Bénin, Miss Gbévivi Bénin images";

// Insère une transformation Cloudinary (recadrage carré + format/qualité
// auto) directement dans l'URL fournie, pour ne charger que des vignettes
// légères sur la grille — le clic ouvre la photo en pleine résolution dans
// un nouvel onglet.
function thumb(url) {
  return url.replace("/upload/", "/upload/w_500,h_500,c_fill,g_auto,f_auto,q_auto/");
}

