---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
>
  <main class="min-h-screen bg-white">
    <section class="bg-gradient-primary py-16 sm:py-20 text-white text-center px-4">
      <p class="text-sm font-semibold uppercase tracking-widest text-white/70">Miss Gbévivi Bénin</p>
      <h1 class="mt-2 font-heading text-4xl font-black sm:text-5xl">Galerie</h1>
      <p class="mx-auto mt-3 max-w-2xl text-lg text-white/90">
        Les moments marquants du concours en images.
      </p>
    </section>

    <section class="px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-y-3">
          {PHOTOS.map((url, i) => (
            <a
              href={url}
              target="_blank"
              rel="noopener noreferrer"
              class="group block aspect-square overflow-hidden rounded-xl shadow-sm hover:shadow-lg transition-shadow"
              aria-label="Voir la photo en pleine résolution"
            >
              <img
                src={thumb(url)}
                alt="Miss Gbévivi Bénin"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading={i < 10 ? "eager" : "lazy"}
              />
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
