---
import BaseLayout from "../layouts/BaseLayout.astro";
import TicketPurchase from "../components/TicketPurchase.jsx";

const title = "Tickets – Miss Gbévivi Bénin 2026";
const description = "Achetez votre ticket en ligne pour le concours Miss Gbévivi Bénin. Paiement 100% sécurisé.";
const keywords = "ticket Miss Gbévivi Bénin, tickets Miss Gbévivi Bénin, ticket concours Bénin, acheter ticket Bénin";
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
>
  <main class="relative min-h-screen overflow-hidden bg-gradient-to-b from-primary-50 via-white to-secondary-50">

    {/* Orbes décoratives en dégradé */}
    <div class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-24 -left-24 h-96 w-96 rounded-full bg-primary-400/30 blur-3xl animate-float"></div>
      <div class="absolute top-1/3 -right-32 h-[28rem] w-[28rem] rounded-full bg-secondary-400/20 blur-3xl animate-float" style="animation-delay: 1.5s"></div>
      <div class="absolute bottom-0 left-1/4 h-72 w-72 rounded-full bg-primary-300/20 blur-3xl animate-float" style="animation-delay: 3s"></div>
    </div>

    {/* Hero dégradé */}
    <div class="relative bg-gradient-to-r from-primary-600 via-primary-500 to-secondary-600 py-10 sm:py-16 px-4 sm:px-6 lg:px-8 text-center overflow-hidden">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_rgba(255,255,255,0.15),_transparent_60%)]"></div>
      <div class="relative mx-auto max-w-3xl space-y-3 sm:space-y-4 animate-fade-up">
        <p class="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] sm:tracking-[0.3em] text-white/80">Tickets officiels</p>
        <h1 class="text-3xl sm:text-4xl md:text-6xl font-heading font-black text-white drop-shadow-sm">
          Achetez votre ticket
        </h1>
        <p class="text-base sm:text-lg text-white/90 max-w-2xl mx-auto px-2">
          Réservez votre place pour le concours Miss Gbévivi Bénin.
        </p>
      </div>
    </div>

    <div class="relative mx-auto max-w-5xl px-3 sm:px-6 lg:px-8 py-8 sm:py-16">
      <div class="glass rounded-2xl sm:rounded-3xl shadow-premium border border-white/40 p-4 sm:p-10 animate-fade-up" style="animation-delay: 0.15s">
        <TicketPurchase client:load />
      </div>
    </div>
  </main>
</BaseLayout>
