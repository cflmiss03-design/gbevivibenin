---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CandidateGrid from '../../components/CandidateGrid.jsx';
import Progress from '../../components/Progress.jsx';
import { candidates as theatreCandidates } from '../../data/theatre-candidates.js';

const title = "Concours de Théâtre Culturel – 1ère édition | Miss Gbévivi Bénin";
const description = "1ère édition du Concours de Théâtre Culturel, autour du thème « Je donne de la valeur à ma culture ». Découvrez les groupes en compétition et votez en ligne.";
const keywords = "Concours Théâtre Culturel, théâtre béninois, Miss Gbévivi Bénin, culture béninoise, groupes théâtraux Bénin";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Event",
      "@id": "https://missgbevivibenin.site/theatre-culturel/#event",
      "name": "Concours de Théâtre Culturel — 1ère édition",
      "description": description,
      "eventStatus": "EventScheduled",
      "eventAttendanceMode": "OnlineEventAttendanceMode",
      "url": "https://missgbevivibenin.site/theatre-culturel",
      "organizer": { "@type": "Organization", "name": "Miss Gbévivi Bénin" },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  ogTitle={title}
  ogDescription={description}
  ogType="website"
  structuredData={structuredData}
>
  <main class="min-h-screen bg-white">
    <!-- Hero -->
    <section class="relative overflow-hidden px-4 py-16 text-center text-white sm:py-24">
      <div class="absolute inset-0 -z-10" style="background: linear-gradient(135deg, #550014 0%, #800020 35%, #B8941F 75%, #D4AF37 100%);"></div>
      <div class="absolute -top-24 -left-24 -z-10 h-72 w-72 rounded-full bg-white/10 blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 -z-10 h-72 w-72 rounded-full bg-secondary-400/20 blur-3xl"></div>

      <p class="text-sm font-semibold uppercase tracking-[0.3em] text-white/80">Miss Gbévivi Bénin</p>
      <h1 class="mt-3 font-heading text-4xl font-black sm:text-5xl">Concours de Théâtre Culturel</h1>
      <p class="mt-2 text-lg font-semibold text-white/90">1ère édition</p>
      <p class="mx-auto mt-4 max-w-2xl text-base italic text-white/85 sm:text-lg">
        « Je donne de la valeur à ma culture »
      </p>
      <p class="mx-auto mt-4 max-w-2xl text-sm text-white/75 sm:text-base">
        Des groupes théâtraux font vivre nos traditions, nos valeurs et notre identité culturelle sur scène.
        Soutenez votre groupe préféré en votant en ligne.
      </p>
    </section>

    <section class="px-4 py-8 sm:px-6 lg:px-8">
      <Progress client:load />
    </section>

    <section id="candidates" class="px-4 pb-16 sm:px-6 sm:pb-24 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <CandidateGrid
          candidates={theatreCandidates}
          eyebrow="Découvrez les groupes"
          title="Les Groupes en Compétition"
          intro="Chaque groupe porte sur scène un pan de notre patrimoine culturel. Votez pour votre groupe préféré et soutenez la transmission de nos traditions."
          cardBadgeLabel="Groupe officiel"
          client:load
        />
      </div>
    </section>
  </main>
</BaseLayout>
